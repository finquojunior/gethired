# Required in production (startup fails without these)
DATABASE_URL=postgresql://user:pass@host:6543/dbname   # use the POOLED string on serverless
APP_URL=https://hiring.example.com                     # base URL used in candidate emails

# Email delivery (without RESEND_API_KEY, emails are only logged to email_log)
RESEND_API_KEY=
EMAIL_FROM="Hiring <hiring@yourdomain.com>"            # required in production when RESEND_API_KEY is set

# Protects /api/cron (required in production; Vercel cron sends it automatically)
CRON_SECRET=

# Signs staff session cookies (required in production; 32+ random chars)
SESSION_SECRET=

# Supabase Storage for uploads (required on Vercel — local disk is ephemeral there)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Org timezone for all candidate-facing times (default Asia/Kolkata)
ORG_TZ=Asia/Kolkata
